# Normalize line endings: LF in the repository, native in the working tree.
# Matters because the Linux CI runner (Stage 4 TSan job) and the Python
# client/gateway need LF, while development happens on Windows.
* text=auto

# Windows-only scripts keep CRLF so they behave in PowerShell/cmd.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Always LF, even checked out on Windows.
*.sh  text eol=lf
*.py  text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
